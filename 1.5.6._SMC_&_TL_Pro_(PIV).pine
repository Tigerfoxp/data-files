indicator("Smart Money & Trendlines Pro (PIV)", shorttitle="SMC & TL Pro (PIV)", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_bars_back=5000)

// ==============================================================================
// 1. SYNTHETIC VOLUME ENGINE (36 TICKERS, per-ticker vol & close)
// ==============================================================================
grpVol = "Synthetic Volume (MOEX, 36 tickers)"
useSynth = input.bool(true, "Use synthetic volume for indices", group=grpVol)
exchPrefix = input.string("MOEX:", "Exchange prefix", group=grpVol)

t01 = input.string("LKOH", "Ticker 01", group=grpVol)
t02 = input.string("SBER", "Ticker 02", group=grpVol)
t03 = input.string("GAZP", "Ticker 03", group=grpVol)
t04 = input.string("YDEX", "Ticker 04", group=grpVol)
