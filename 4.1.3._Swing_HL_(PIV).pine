// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © ProInvestView
// v4.1.3 — 2026-10-28
// Changelog v4.1.3:
//  - Badges: unified badgeBaseATR input (0.3 default). High: V at +4.0, % at +1.5 (wider gap, higher).
//    Low: V at -3.5, % at -1.6 (unchanged visually). Fixes High-badge "flatness".
//  - Volume display: stocks now show turnover (M/B rub, dynamic suffix) instead of raw volume.
//    Indices keep synthVol (B rub). Scoring unaffected (Z-score/ratio are scale-invariant).
//    Dashboard header "Vol, mlrd" → "Vol, rub".

//@version=5
indicator("Swing High Low (ProInvestView)", shorttitle="Swing H/L (PIV)", overlay=true, max_lines_count=50, max_labels_count=500)

// ============== НАСТРОЙКИ: SWING DETECTION ==============
highStrength = input.int(5, "Swing High strength", minval=1, maxval=10, group="Swing detection")
lowStrength  = input.int(5, "Swing Low strength",  minval=1, maxval=10, group="Swing detection")
highSource   = input.source(high, "Swing High source", group="Swing detection")
lowSource    = input.source(low,  "Swing Low source",  group="Swing detection")

// ============== НАСТРОЙКИ: DISPLAY ==============
showInfoTable   = input.bool(false, "Show Info Table", group="Display")
showValues      = input.bool(true,  "Show Values",     group="Display")
highLabelOffset = input.float(0.1, "Swing High label offset (ATR)", minval=0.0, step=0.05, group="Display")
lowLabelOffset  = input.float(0.3, "Swing Low label offset (ATR)",  minval=0.0, step=0.05, group="Display")
badgeBaseATR    = input.float(0.3, "Badge base offset (ATR)", minval=0.1, maxval=1.0, step=0.05, group="Display")

// ============== НАСТРОЙКИ: COLORS ==============
colHighMain = input.color(color.red,  "Swing High color", group="Colors")
colLowMain  = input.color(color.teal, "Swing Low color",  group="Colors")
colText     = input.color(color.gray, "Value text color", group="Colors")

// ============== НАСТРОЙКИ: STYLE ==============
circleWidth = input.int(2, "Circle width",     minval=1, maxval=5, group="Style")
solidWidth  = input.int(2, "Solid line width", minval=1, maxval=4, group="Style")

// ============== НАСТРОЙКИ: HTF ==============
showHTF1H      = input.bool(true,  "Show 1H HTF levels", group="HTF levels")
showHTF4H      = input.bool(true,  "Show 4H HTF levels", group="HTF levels")
showHTFD       = input.bool(true,  "Show D HTF levels",  group="HTF levels")
showHTFW       = input.bool(true,  "Show W HTF levels",  group="HTF levels")
showConfluence = input.bool(false, "Show confluence (LTF/HTF)", group="HTF levels")
htfStrength    = input.int(5, "HTF swing strength", minval=1, maxval=10, group="HTF levels")

col1HHigh = input.color(#FF6D00, "1H High color", group="HTF colors")
col1HLow  = input.color(#26C6DA, "1H Low color",  group="HTF colors")
col4HHigh = input.color(#E91E63, "4H High color", group="HTF colors")
col4HLow  = input.color(#2196F3, "4H Low color",  group="HTF colors")
colDHigh  = input.color(#9C27B0, "D High color",  group="HTF colors")
colDLow   = input.color(#3F51B5, "D Low color",   group="HTF colors")
colWHigh  = input.color(#673AB7, "W High color",  group="HTF colors")
colWLow   = input.color(#1A237E, "W Low color",   group="HTF colors")

// ============== НАСТРОЙКИ: STRENGTH SCORING ==============
showStrength = input.bool(true, "Show Strength Score", group="Strength scoring")
showTooltip  = input.bool(true, "Show Tooltip on hover", group="Strength scoring")

// Z-score
useZScore    = input.bool(true, "Use Z-score thresholds", group="Strength scoring")
autoZLB      = input.bool(true, "Auto Z-lookback by timeframe", group="Strength scoring")
manualZLB    = input.int(104, "Manual Z-lookback (bars)", minval=10, maxval=500, group="Strength scoring")
zThreshold   = input.float(1.0, "Z-score threshold (sigma)", minval=0.5, step=0.1, group="Strength scoring")
histLookback = input.int(104, "Historical significance lookback (bars)", minval=20, maxval=520, group="Strength scoring")

wVol    = input.float(25, "Weight: Volume",         minval=0, maxval=100, step=1, group="Strength weights")
wRange  = input.float(10, "Weight: Range",          minval=0, maxval=100, step=1, group="Strength weights")
wWick   = input.float(10, "Weight: Wick",           minval=0, maxval=100, step=1, group="Strength weights")
wSpeed  = input.float(10, "Weight: Speed",          minval=0, maxval=100, step=1, group="Strength weights")
wRetest = input.float(15, "Weight: Retests",        minval=0, maxval=100, step=1, group="Strength weights")
wConfl  = input.float(20, "Weight: HTF confluence", minval=0, maxval=100, step=1, group="Strength weights")
wDiver  = input.float(5,  "Weight: RSI divergence (confirms exhaustion)", minval=0, maxval=50, step=1, group="Strength weights")
wStruct = input.float(5,  "Weight: Market structure", minval=0, maxval=100, step=1, group="Strength weights")

volThreshold   = input.float(1.5, "Volume ratio threshold (fixed mode)", minval=0.5, step=0.1, group="Strength thresholds")
rangeThreshold = input.float(1.2, "Range ratio threshold (fixed mode)",  minval=0.5, step=0.1, group="Strength thresholds")
wickThreshold  = input.float(0.6, "Wick ratio threshold",     minval=0.1, step=0.1, group="Strength thresholds")
speedThreshold = input.float(0.8, "Speed threshold (ATR)",    minval=0.1, step=0.1, group="Strength thresholds")
retestMin      = input.int(2,      "Min retests count",        minval=1, maxval=10, group="Strength thresholds")
retestAtrMult  = input.float(0.35, "Retest zone width (ATR)",  minval=0.1, maxval=1.0, step=0.05, group="Strength thresholds")
confluTol      = input.float(0.3,  "Confluence tolerance (%)", minval=0.1, step=0.1, group="Strength thresholds")

// ============== НАСТРОЙКИ: DASHBOARD ==============
showDashboard = input.bool(true, "Show Dashboard", group="Dashboard")
compactDash   = input.bool(true, "Compact Dashboard (metrics only)", group="Dashboard")
dashPosStr    = input.string("Top Right", "Dashboard position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group="Dashboard")

// ============== НАСТРОЙКИ: SYNTHETIC VOLUME ==============
useSynth   = input.bool(true,  "Use synthetic volume for indices", group="Synthetic volume")
exchPrefix = input.string("MOEX:", "Exchange prefix", group="Synthetic volume")
t01 = input.string("LKOH",  "Ticker 01", group="Synthetic volume")
t02 = input.string("SBER",  "Ticker 02", group="Synthetic volume")
t03 = input.string("GAZP",  "Ticker 03", group="Synthetic volume")
t04 = input.string("YDEX",  "Ticker 04", group="Synthetic volume")
t05 = input.string("TATN",  "Ticker 05", group="Synthetic volume")
t06 = input.string("T",     "Ticker 06", group="Synthetic volume")
t07 = input.string("GMKN",  "Ticker 07", group="Synthetic volume")
t08 = input.string("NVTK",  "Ticker 08", group="Synthetic volume")
t09 = input.string("ROSN",  "Ticker 09", group="Synthetic volume")
t10 = input.string("X5",    "Ticker 10", group="Synthetic volume")
t11 = input.string("VTBR",  "Ticker 11", group="Synthetic volume")
t12 = input.string("SBERP", "Ticker 12", group="Synthetic volume")
t13 = input.string("OZON",  "Ticker 13", group="Synthetic volume")
t14 = input.string("PLZL",  "Ticker 14", group="Synthetic volume")
t15 = input.string("SNGSP", "Ticker 15", group="Synthetic volume")
t16 = input.string("SNGS",  "Ticker 16", group="Synthetic volume")
t17 = input.string("HEAD",  "Ticker 17", group="Synthetic volume")
t18 = input.string("TATNP", "Ticker 18", group="Synthetic volume")
t19 = input.string("MOEX",  "Ticker 19", group="Synthetic volume")
t20 = input.string("MTSS",  "Ticker 20", group="Synthetic volume")
t21 = input.string("IRAO",  "Ticker 21", group="Synthetic volume")
t22 = input.string("RUAL",  "Ticker 22", group="Synthetic volume")
t23 = input.string("CBOM",  "Ticker 23", group="Synthetic volume")
t24 = input.string("CHMF",  "Ticker 24", group="Synthetic volume")
t25 = input.string("NLMK",  "Ticker 25", group="Synthetic volume")

// ============== TF VISIBILITY + ADAPTIVE LOOKBACK ==============
curSec     = timeframe.in_seconds()
curSecSafe = curSec > 0 ? curSec : 1
show1h = showHTF1H and curSec > 0 and curSec < 3600
show4h = showHTF4H and curSec > 0 and curSec < 14400
showD  = showHTFD  and curSec > 0 and curSec < 86400
showW  = showHTFW  and curSec > 0 and curSec < 604800
hasHTF = show1h or show4h or showD or showW

// adaptive Z-lookback refreshed for ~6 trading days/week (MOEX weekend sessions)
adaptiveZLB = curSec >= 604800 ? 72 : curSec >= 86400 ? 180 : curSec >= 14400 ? 84 : curSec >= 3600 ? 84 : 168
zLookback = autoZLB ? adaptiveZLB : manualZLB

tfStr = timeframe.isminutes ? (timeframe.multiplier == 60 ? "1H" : timeframe.multiplier == 120 ? "2H" : timeframe.multiplier == 240 ? "4H" : str.tostring(timeframe.multiplier) + "m") : timeframe.isdaily ? "D" : timeframe.isweekly ? "W" : timeframe.ismonthly ? "M" : timeframe.period

// ============== SYNTHETIC VOLUME ==============
sv1  = request.security(exchPrefix + t01, timeframe.period, volume * close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
sv2  = request.security(exchPrefix + t02, timeframe.period, volume * close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
sv3  = request.security(exchPrefix + t03, timeframe.period, volume * close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
sv4  = request.security(exchPrefix + t04, timeframe.period, volume * close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
sv5  = request.security(exchPrefix + t05, timeframe.period, volume * close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
sv6  = request.security(exchPrefix + t06, timeframe.period, volume * close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
sv7  = request.security(exchPrefix + t07, timeframe.period, volume * close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
sv8  = request.security(exchPrefix + t08, timeframe.period, volume * close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
sv9  = request.security(exchPrefix + t09, timeframe.period, volume * close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
sv10 = request.security(exchPrefix + t10, timeframe.period, volume * close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
sv11 = request.security(exchPrefix + t11, timeframe.period, volume * close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
sv12 = request.security(exchPrefix + t12, timeframe.period, volume * close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
sv13 = request.security(exchPrefix + t13, timeframe.period, volume * close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
sv14 = request.security(exchPrefix + t14, timeframe.period, volume * close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
sv15 = request.security(exchPrefix + t15, timeframe.period, volume * close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
sv16 = request.security(exchPrefix + t16, timeframe.period, volume * close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
sv17 = request.security(exchPrefix + t17, timeframe.period, volume * close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
sv18 = request.security(exchPrefix + t18, timeframe.period, volume * close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
sv19 = request.security(exchPrefix + t19, timeframe.period, volume * close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
sv20 = request.security(exchPrefix + t20, timeframe.period, volume * close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
sv21 = request.security(exchPrefix + t21, timeframe.period, volume * close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
sv22 = request.security(exchPrefix + t22, timeframe.period, volume * close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
sv23 = request.security(exchPrefix + t23, timeframe.period, volume * close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
sv24 = request.security(exchPrefix + t24, timeframe.period, volume * close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
sv25 = request.security(exchPrefix + t25, timeframe.period, volume * close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)

synthVol = (nz(sv1) + nz(sv2) + nz(sv3) + nz(sv4) + nz(sv5) + nz(sv6) + nz(sv7) + nz(sv8) + nz(sv9) + nz(sv10) + nz(sv11) + nz(sv12) + nz(sv13) + nz(sv14) + nz(sv15) + nz(sv16) + nz(sv17) + nz(sv18) + nz(sv19) + nz(sv20) + nz(sv21) + nz(sv22) + nz(sv23) + nz(sv24) + nz(sv25)) / 1e9

// valid ticker counter
validSynth = (na(sv1)?0:1) + (na(sv2)?0:1) + (na(sv3)?0:1) + (na(sv4)?0:1) + (na(sv5)?0:1) + (na(sv6)?0:1) + (na(sv7)?0:1) + (na(sv8)?0:1) + (na(sv9)?0:1) + (na(sv10)?0:1) + (na(sv11)?0:1) + (na(sv12)?0:1) + (na(sv13)?0:1) + (na(sv14)?0:1) + (na(sv15)?0:1) + (na(sv16)?0:1) + (na(sv17)?0:1) + (na(sv18)?0:1) + (na(sv19)?0:1) + (na(sv20)?0:1) + (na(sv21)?0:1) + (na(sv22)?0:1) + (na(sv23)?0:1) + (na(sv24)?0:1) + (na(sv25)?0:1)

isIndexVol = (syminfo.type == "index" and useSynth)
volSource  = isIndexVol ? synthVol : volume

// ============== HTF REQUESTS ==============
htf1hHigh = request.security(syminfo.tickerid, "60",  ta.pivothigh(high, htfStrength, htfStrength), lookahead=barmerge.lookahead_off)
htf1hLow  = request.security(syminfo.tickerid, "60",  ta.pivotlow(low,  htfStrength, htfStrength), lookahead=barmerge.lookahead_off)
htf1hTime = request.security(syminfo.tickerid, "60",  time[htfStrength], lookahead=barmerge.lookahead_off)
htf4hHigh = request.security(syminfo.tickerid, "240", ta.pivothigh(high, htfStrength, htfStrength), lookahead=barmerge.lookahead_off)
htf4hLow  = request.security(syminfo.tickerid, "240", ta.pivotlow(low,  htfStrength, htfStrength), lookahead=barmerge.lookahead_off)
htf4hTime = request.security(syminfo.tickerid, "240", time[htfStrength], lookahead=barmerge.lookahead_off)
htfDHigh  = request.security(syminfo.tickerid, "D",   ta.pivothigh(high, htfStrength, htfStrength), lookahead=barmerge.lookahead_off)
htfDLow   = request.security(syminfo.tickerid, "D",   ta.pivotlow(low,  htfStrength, htfStrength), lookahead=barmerge.lookahead_off)
htfDTime  = request.security(syminfo.tickerid, "D",   time[htfStrength], lookahead=barmerge.lookahead_off)
htfWHigh  = request.security(syminfo.tickerid, "W",   ta.pivothigh(high, htfStrength, htfStrength), lookahead=barmerge.lookahead_off)
htfWLow   = request.security(syminfo.tickerid, "W",   ta.pivotlow(low,  htfStrength, htfStrength), lookahead=barmerge.lookahead_off)
htfWTime  = request.security(syminfo.tickerid, "W",   time[htfStrength], lookahead=barmerge.lookahead_off)

// ============== HTF STATE ==============
var float v1hHigh = na
var int   t1hHigh = na
var float v1hLow  = na
var int   t1hLow  = na
var float v4hHigh = na
var int   t4hHigh = na
var float v4hLow  = na
var int   t4hLow  = na
var float vDHigh  = na
var int   tDHigh  = na
var float vDLow   = na
var int   tDLow   = na
var float vWHigh  = na
var int   tWHigh  = na
var float vWLow   = na
var int   tWLow   = na

if not na(htf1hHigh)
    v1hHigh := htf1hHigh
    t1hHigh := htf1hTime
if not na(htf1hLow)
    v1hLow := htf1hLow
    t1hLow := htf1hTime
if not na(htf4hHigh)
    v4hHigh := htf4hHigh
    t4hHigh := htf4hTime
if not na(htf4hLow)
    v4hLow := htf4hLow
    t4hLow := htf4hTime
if not na(htfDHigh)
    vDHigh := htfDHigh
    tDHigh := htfDTime
if not na(htfDLow)
    vDLow := htfDLow
    tDLow := htfDTime
if not na(htfWHigh)
    vWHigh := htfWHigh
    tWHigh := htfWTime
if not na(htfWLow)
    vWLow := htfWLow
    tWLow := htfWTime

// ============== SWING + GLOBAL TA ==============
sHigh  = ta.pivothigh(highSource, highStrength, highStrength)
sLow   = ta.pivotlow(lowSource,  lowStrength,  lowStrength)
atr    = ta.atr(14)
smaVol = ta.sma(volSource, zLookback)
stdVol = ta.stdev(volSource, zLookback)
rangeS = high - low
smaRng = ta.sma(rangeS, zLookback)
stdRng = ta.stdev(rangeS, zLookback)
rsiVal = ta.rsi(close, 14)
histHigh = ta.highest(high, histLookback)
histLow  = ta.lowest(low, histLookback)

yOffHigh = atr * highLabelOffset
yOffLow  = atr * lowLabelOffset

// ============== CURRENT TF STATE ==============
var float activeHighValue = na
var int   activeHighStart = na
var int   lastHighConf    = na
var float prevHighAtConf  = na
var float activeLowValue = na
var int   activeLowStart = na
var int   lastLowConf    = na
var float prevLowAtConf  = na

newHigh = not na(sHigh) and (na(lastHighConf) or lastHighConf != bar_index)
newLow  = not na(sLow)  and (na(lastLowConf)  or lastLowConf  != bar_index)

// ============== STRENGTH SCORING STATE ==============
var float  frozenHighScore  = na
var int    frozenHighCnt    = na
var float  frozenHighVol    = na
var string frozenHighVolStr = ""
var int    frozenHighSize   = na
var string frozenHighTip    = ""
var bool[] hF = array.new_bool(8, false)

var float  frozenLowScore  = na
var int    frozenLowCnt    = na
var float  frozenLowVol    = na
var string frozenLowVolStr = ""
var int    frozenLowSize   = na
var string frozenLowTip    = ""
var bool[] lF = array.new_bool(8, false)

var float prevSwingHighValue   = na
var int   prevSwingHighBar     = na
var int   prevSwingHighConfBar = na
var float prevSwingHighAtr     = na
var float prevSwingLowValue    = na
var int   prevSwingLowBar      = na
var int   prevSwingLowConfBar  = na
var float prevSwingLowAtr      = na

var label badgeHighL = na
var label badgeHighR = na
var label badgeLowL  = na
var label badgeLowR  = na

var label[] hTriLabels = array.new_label()
var label[] lTriLabels = array.new_label()
const int MAX_TRI_LABELS = 120

var label[] highValueLabels = array.new_label()
var label[] lowValueLabels  = array.new_label()
const int MAX_VALUE_PER_SIDE = 30

var label activeHighLbl = na
var label activeLowLbl  = na

// ============== VALUE LABELS (current TF active) ==============
if newHigh
    lastHighConf    := bar_index
    prevHighAtConf  := activeHighValue
    activeHighStart := math.max(bar_index - highStrength, 0)
    activeHighValue := sHigh

    if not na(activeHighLbl) and not na(prevHighAtConf)
        label.set_x(activeHighLbl, math.max(bar_index - 1, 0))
        array.push(highValueLabels, activeHighLbl)
        while array.size(highValueLabels) > MAX_VALUE_PER_SIDE
            label oldV = array.shift(highValueLabels)
            label.delete(oldV)

    if showValues
        activeHighLbl := label.new(bar_index, sHigh + yOffHigh, str.tostring(sHigh, format.mintick),
             style=label.style_none, textcolor=colText, size=size.small, textalign=text.align_center)
    else
        activeHighLbl := na
else
    if showValues and not na(activeHighLbl) and not na(activeHighValue)
        label.set_x(activeHighLbl, bar_index)

if newLow
    lastLowConf    := bar_index
    prevLowAtConf  := activeLowValue
    activeLowStart := math.max(bar_index - lowStrength, 0)
    activeLowValue := sLow

    if not na(activeLowLbl) and not na(prevLowAtConf)
        label.set_x(activeLowLbl, math.max(bar_index - 1, 0))
        array.push(lowValueLabels, activeLowLbl)
        while array.size(lowValueLabels) > MAX_VALUE_PER_SIDE
            label oldVL = array.shift(lowValueLabels)
            label.delete(oldVL)

    if showValues
        activeLowLbl := label.new(bar_index, sLow - yOffLow, str.tostring(sLow, format.mintick),
             style=label.style_none, textcolor=colText, size=size.small, textalign=text.align_center)
    else
        activeLowLbl := na
else
    if showValues and not na(activeLowLbl) and not na(activeLowValue)
        label.set_x(activeLowLbl, bar_index)

// ============== HELPER: quality label ==============
qualityLabel(float sc) =>
    sc < 30 ? "Weak" : sc < 60 ? "Medium" : sc < 80 ? "Med-Strong" : "Strong"

// v4.1.3: volume display helper — stocks show turnover (M/B rub), indices show synthVol (B rub)
fmtDisplayVol(float v, bool isIdx, float px) =>
    string res = ""
    if isIdx
        res := str.tostring(v, "#.##") + "B"
    else
        float tOverM = v * px / 1e6
        res := tOverM >= 1000 ? str.tostring(tOverM / 1000, "#.##") + "B" : str.tostring(tOverM, "#.#") + "M"
    res

// ============== STRENGTH SCORING: HIGH ==============
if newHigh and showStrength
    int pivotBarH = math.max(bar_index - highStrength, 0)
    float vCurrH  = volSource[highStrength]
    float vAvgH   = smaVol[highStrength]
    float vStdH   = stdVol[highStrength]
    float volRatioH = (not na(vAvgH) and vAvgH > 0) ? vCurrH / vAvgH : 0.0
    float volZ_H    = (not na(vStdH) and vStdH > 0) ? (vCurrH - vAvgH) / vStdH : 0.0

    bool f1H = useZScore ? (volZ_H > zThreshold) : (not na(vAvgH) and vAvgH > 0 and volRatioH > volThreshold)

    float rngH    = rangeS[highStrength]
    float rngAvgH = smaRng[highStrength]
    float rngStdH = stdRng[highStrength]
    float atrH    = atr[highStrength]
    float rngRatioH = (not na(atrH) and atrH > 0) ? rngH / atrH : 0.0
    float rngZ_H    = (not na(rngStdH) and rngStdH > 0) ? (rngH - rngAvgH) / rngStdH : 0.0

    bool f2H = useZScore ? (rngZ_H > zThreshold) : (not na(atrH) and atrH > 0 and rngRatioH > rangeThreshold)

    float wickH = rngH > 0 ? (high[highStrength] - close[highStrength]) / rngH : 0.0
    bool f3H = wickH > wickThreshold

    float distH = (not na(atrH) and atrH > 0) ? math.abs(close - close[highStrength]) / atrH : 0.0
    bool f4H = distH > speedThreshold

    int retH = 0
    float zoneH = na
    if not na(prevSwingHighValue) and not na(prevSwingHighAtr) and not na(prevSwingHighConfBar)
        zoneH := prevSwingHighAtr * retestAtrMult
        int startChk = prevSwingHighConfBar + 1
        int endChk   = math.min(bar_index - highStrength - 1, prevSwingHighConfBar + 200)
        if endChk >= startChk
            for i = startChk to endChk
                int offs = bar_index - i
                if offs >= 0
                    bool touched = (high[offs] >= prevSwingHighValue - zoneH and low[offs] <= prevSwingHighValue + zoneH)
                    if touched
                        retH += 1
    bool f5H = retH >= retestMin

    string confStrH = ""
    bool f6H = false
    if hasHTF
        bool c1 = show1h and not na(v1hHigh) and v1hHigh > 0 and math.abs(v1hHigh - sHigh) / sHigh <= confluTol / 100
        bool c4 = show4h and not na(v4hHigh) and v4hHigh > 0 and math.abs(v4hHigh - sHigh) / sHigh <= confluTol / 100
        bool cD = showD  and not na(vDHigh)  and vDHigh  > 0 and math.abs(vDHigh  - sHigh) / sHigh <= confluTol / 100
        bool cW = showW  and not na(vWHigh)  and vWHigh  > 0 and math.abs(vWHigh  - sHigh) / sHigh <= confluTol / 100
        if c1
            confStrH := confStrH + (confStrH == "" ? "" : ", ") + "1H"
        if c4
            confStrH := confStrH + (confStrH == "" ? "" : ", ") + "4H"
        if cD
            confStrH := confStrH + (confStrH == "" ? "" : ", ") + "D"
        if cW
            confStrH := confStrH + (confStrH == "" ? "" : ", ") + "W"
        f6H := confStrH != ""
    else
        float hh = histHigh[highStrength]
        f6H := not na(hh) and sHigh >= hh
        if f6H
            confStrH := "Historic(104)"

    float rsiCurrH = rsiVal[highStrength]
    bool divH = false
    if not na(prevSwingHighBar) and not na(prevSwingHighValue)
        int diffBars = bar_index - highStrength - prevSwingHighBar
        if diffBars > 0 and diffBars < 500
            float rsiPrevH = rsiVal[diffBars + highStrength]
            bool priceHH = sHigh > prevSwingHighValue
            bool rsiLH   = not na(rsiPrevH) and not na(rsiCurrH) and rsiCurrH < rsiPrevH
            divH := priceHH and rsiLH
    bool f7H = divH

    bool f8H = not na(prevSwingHighValue) and sHigh > prevSwingHighValue

    int   cntH = (f1H?1:0) + (f2H?1:0) + (f3H?1:0) + (f4H?1:0) + (f5H?1:0) + (f6H?1:0) + (f7H?1:0) + (f8H?1:0)
    float scrH_raw = (f1H?wVol:0) + (f2H?wRange:0) + (f3H?wWick:0) + (f4H?wSpeed:0) + (f5H?wRetest:0) + (f6H?wConfl:0) + (f7H?wDiver:0) + (f8H?wStruct:0)
    float scrH = math.min(scrH_raw, 100)

    frozenHighScore  := scrH
    frozenHighCnt    := cntH
    frozenHighVol    := vCurrH
    frozenHighVolStr := fmtDisplayVol(vCurrH, isIndexVol, close[highStrength])
    frozenHighSize   := scrH <= 40 ? 1 : scrH <= 70 ? 2 : 3

    array.set(hF, 0, f1H)
    array.set(hF, 1, f2H)
    array.set(hF, 2, f3H)
    array.set(hF, 3, f4H)
    array.set(hF, 4, f5H)
    array.set(hF, 5, f6H)
    array.set(hF, 6, f7H)
    array.set(hF, 7, f8H)

    string volDescH = isIndexVol ? "synth, 25 tickers" : "turnover"
    string tipH = "═══ SCORE " + str.tostring(scrH, "#.#") + "% · " + qualityLabel(scrH) + " ═══\n"
    tipH := tipH + "Swing High @ " + str.tostring(sHigh, format.mintick) + " (" + tfStr + ")\n"
    tipH := tipH + "Time: " + str.format_time(time[highStrength], "dd MMM yyyy HH:mm", syminfo.timezone) + "\n"
    tipH := tipH + "Volume: " + frozenHighVolStr + " rub (" + volDescH + ", " + str.tostring(volRatioH, "#.##") + "x SMA, z=" + str.tostring(volZ_H, "#.##") + ")\n"
    if confStrH != ""
        tipH := tipH + "Confluence: " + confStrH + "\n"
    tipH := tipH + "─────────────────\n"
    tipH := tipH + "FACTORS: " + str.tostring(cntH) + "/8\n"
    tipH := tipH + (f1H ? "🟢" : "⚪") + " Volume     25%  " + (useZScore ? "z=" + str.tostring(volZ_H, "#.##") + " > " + str.tostring(zThreshold, "#.#") : "ratio " + str.tostring(volRatioH, "#.##") + " > " + str.tostring(volThreshold, "#.#")) + "\n"
    tipH := tipH + (f2H ? "🟢" : "⚪") + " Range      10%  " + (useZScore ? "z=" + str.tostring(rngZ_H, "#.##") + " > " + str.tostring(zThreshold, "#.#") : str.tostring(rngRatioH, "#.##") + "x ATR") + "\n"
    tipH := tipH + (f3H ? "🟢" : "⚪") + " Wick       10%  " + str.tostring(wickH, "#.##") + " > " + str.tostring(wickThreshold, "#.#") + "\n"
    tipH := tipH + (f4H ? "🟢" : "⚪") + " Speed      10%  " + str.tostring(distH, "#.##") + "x ATR > " + str.tostring(speedThreshold, "#.#") + "\n"
    string zoneHStr = na(zoneH) ? "n/a" : str.tostring(prevSwingHighValue - zoneH, format.mintick) + "–" + str.tostring(prevSwingHighValue + zoneH, format.mintick)
    tipH := tipH + (f5H ? "🟢" : "⚪") + " Retests    15%  " + str.tostring(retH) + " touches [zone " + zoneHStr + " ±" + str.tostring(retestAtrMult, "#.##") + "·ATR] vs " + str.tostring(retestMin) + "\n"
    tipH := tipH + (f6H ? "🟢" : "⚪") + " Confluence 20%  " + (confStrH != "" ? confStrH : "none") + "\n"
    tipH := tipH + (f7H ? "🟢" : "⚪") + " RSI Div    +5%  " + (f7H ? "yes (bearish — confirms exhaustion)" : "no") + "\n"
    tipH := tipH + (f8H ? "🟢" : "⚪") + " Structure   5%  " + (f8H ? "BOS (HH)" : "none") + "\n"
    tipH := tipH + "─────────────────\n"
    tipH := tipH + "Max possible: 100% (all 8 factors, incl. RSI Div)\n"
    tipH := tipH + "Threshold: " + (useZScore ? "Z-score" : "Fixed") + " · LB=" + str.tostring(zLookback) + " bars (" + (autoZLB ? "auto, " : "manual, ") + tfStr + ")"
    frozenHighTip := showTooltip ? tipH : ""

    if not na(badgeHighL)
        label.delete(badgeHighL)
    if not na(badgeHighR)
        label.delete(badgeHighR)
    string volTxt = "V-" + frozenHighVolStr
    string scrTxt = str.tostring(cntH) + "/" + str.tostring(scrH, "#.#") + "%"
    // v4.1.3: High badges lifted higher & wider gap (via badgeBaseATR)
    badgeHighL := label.new(pivotBarH, sHigh + atr * badgeBaseATR * 4.0, volTxt, style=label.style_label_center, textcolor=color.white, size=size.small, textalign=text.align_center, color=color.new(color.black, 70))
    badgeHighR := label.new(pivotBarH, sHigh + atr * badgeBaseATR * 1.5, scrTxt, style=label.style_label_center, textcolor=color.white, size=size.small, textalign=text.align_center, color=color.new(color.black, 70))

    prevSwingHighValue   := sHigh
    prevSwingHighBar     := pivotBarH
    prevSwingHighConfBar := bar_index
    prevSwingHighAtr     := atrH

// ============== STRENGTH SCORING: LOW ==============
if newLow and showStrength
    int pivotBarL = math.max(bar_index - lowStrength, 0)
    float vCurrL  = volSource[lowStrength]
    float vAvgL   = smaVol[lowStrength]
    float vStdL   = stdVol[lowStrength]
    float volRatioL = (not na(vAvgL) and vAvgL > 0) ? vCurrL / vAvgL : 0.0
    float volZ_L    = (not na(vStdL) and vStdL > 0) ? (vCurrL - vAvgL) / vStdL : 0.0

    bool f1L = useZScore ? (volZ_L > zThreshold) : (not na(vAvgL) and vAvgL > 0 and volRatioL > volThreshold)

    float rngL    = rangeS[lowStrength]
    float rngAvgL = smaRng[lowStrength]
    float rngStdL = stdRng[lowStrength]
    float atrL    = atr[lowStrength]
    float rngRatioL = (not na(atrL) and atrL > 0) ? rngL / atrL : 0.0
    float rngZ_L    = (not na(rngStdL) and rngStdL > 0) ? (rngL - rngAvgL) / rngStdL : 0.0

    bool f2L = useZScore ? (rngZ_L > zThreshold) : (not na(atrL) and atrL > 0 and rngRatioL > rangeThreshold)

    float wickL = rngL > 0 ? (close[lowStrength] - low[lowStrength]) / rngL : 0.0
    bool f3L = wickL > wickThreshold

    float distL = (not na(atrL) and atrL > 0) ? math.abs(close - close[lowStrength]) / atrL : 0.0
    bool f4L = distL > speedThreshold

    int retL = 0
    float zoneL = na
    if not na(prevSwingLowValue) and not na(prevSwingLowAtr) and not na(prevSwingLowConfBar)
        zoneL := prevSwingLowAtr * retestAtrMult
        int startChkL = prevSwingLowConfBar + 1
        int endChkL   = math.min(bar_index - lowStrength - 1, prevSwingLowConfBar + 200)
        if endChkL >= startChkL
            for i = startChkL to endChkL
                int offs = bar_index - i
                if offs >= 0
                    bool touchedL = (high[offs] >= prevSwingLowValue - zoneL and low[offs] <= prevSwingLowValue + zoneL)
                    if touchedL
                        retL += 1
    bool f5L = retL >= retestMin

    string confStrL = ""
    bool f6L = false
    if hasHTF
        bool c1L = show1h and not na(v1hLow) and v1hLow > 0 and math.abs(v1hLow - sLow) / sLow <= confluTol / 100
        bool c4L = show4h and not na(v4hLow) and v4hLow > 0 and math.abs(v4hLow - sLow) / sLow <= confluTol / 100
        bool cDL = showD  and not na(vDLow)  and vDLow  > 0 and math.abs(vDLow  - sLow) / sLow <= confluTol / 100
        bool cWL = showW  and not na(vWLow)  and vWLow  > 0 and math.abs(vWLow  - sLow) / sLow <= confluTol / 100
        if c1L
            confStrL := confStrL + (confStrL == "" ? "" : ", ") + "1H"
        if c4L
            confStrL := confStrL + (confStrL == "" ? "" : ", ") + "4H"
        if cDL
            confStrL := confStrL + (confStrL == "" ? "" : ", ") + "D"
        if cWL
            confStrL := confStrL + (confStrL == "" ? "" : ", ") + "W"
        f6L := confStrL != ""
    else
        float ll = histLow[lowStrength]
        f6L := not na(ll) and sLow <= ll
        if f6L
            confStrL := "Historic(104)"

    float rsiCurrL = rsiVal[lowStrength]
    bool divL = false
    if not na(prevSwingLowBar) and not na(prevSwingLowValue)
        int diffBarsL = bar_index - lowStrength - prevSwingLowBar
        if diffBarsL > 0 and diffBarsL < 500
            float rsiPrevL = rsiVal[diffBarsL + lowStrength]
            bool priceLL = sLow < prevSwingLowValue
            bool rsiHL   = not na(rsiPrevL) and not na(rsiCurrL) and rsiCurrL > rsiPrevL
            divL := priceLL and rsiHL
    bool f7L = divL

    bool f8L = not na(prevSwingLowValue) and sLow < prevSwingLowValue

    int   cntL = (f1L?1:0) + (f2L?1:0) + (f3L?1:0) + (f4L?1:0) + (f5L?1:0) + (f6L?1:0) + (f7L?1:0) + (f8L?1:0)
    float scrL_raw = (f1L?wVol:0) + (f2L?wRange:0) + (f3L?wWick:0) + (f4L?wSpeed:0) + (f5L?wRetest:0) + (f6L?wConfl:0) + (f7L?wDiver:0) + (f8L?wStruct:0)
    float scrL = math.min(scrL_raw, 100)

    frozenLowScore  := scrL
    frozenLowCnt    := cntL
    frozenLowVol    := vCurrL
    frozenLowVolStr := fmtDisplayVol(vCurrL, isIndexVol, close[lowStrength])
    frozenLowSize   := scrL <= 40 ? 1 : scrL <= 70 ? 2 : 3

    array.set(lF, 0, f1L)
    array.set(lF, 1, f2L)
    array.set(lF, 2, f3L)
    array.set(lF, 3, f4L)
    array.set(lF, 4, f5L)
    array.set(lF, 5, f6L)
    array.set(lF, 6, f7L)
    array.set(lF, 7, f8L)

    string volDescL = isIndexVol ? "synth, 25 tickers" : "turnover"
    string tipL = "═══ SCORE " + str.tostring(scrL, "#.#") + "% · " + qualityLabel(scrL) + " ═══\n"
    tipL := tipL + "Swing Low @ " + str.tostring(sLow, format.mintick) + " (" + tfStr + ")\n"
    tipL := tipL + "Time: " + str.format_time(time[lowStrength], "dd MMM yyyy HH:mm", syminfo.timezone) + "\n"
    tipL := tipL + "Volume: " + frozenLowVolStr + " rub (" + volDescL + ", " + str.tostring(volRatioL, "#.##") + "x SMA, z=" + str.tostring(volZ_L, "#.##") + ")\n"
    if confStrL != ""
        tipL := tipL + "Confluence: " + confStrL + "\n"
    tipL := tipL + "─────────────────\n"
    tipL := tipL + "FACTORS: " + str.tostring(cntL) + "/8\n"
    tipL := tipL + (f1L ? "🟢" : "⚪") + " Volume     25%  " + (useZScore ? "z=" + str.tostring(volZ_L, "#.##") + " > " + str.tostring(zThreshold, "#.#") : "ratio " + str.tostring(volRatioL, "#.##") + " > " + str.tostring(volThreshold, "#.#")) + "\n"
    tipL := tipL + (f2L ? "🟢" : "⚪") + " Range      10%  " + (useZScore ? "z=" + str.tostring(rngZ_L, "#.##") + " > " + str.tostring(zThreshold, "#.#") : str.tostring(rngRatioL, "#.##") + "x ATR") + "\n"
    tipL := tipL + (f3L ? "🟢" : "⚪") + " Wick       10%  " + str.tostring(wickL, "#.##") + " > " + str.tostring(wickThreshold, "#.#") + "\n"
    tipL := tipL + (f4L ? "🟢" : "⚪") + " Speed      10%  " + str.tostring(distL, "#.##") + "x ATR > " + str.tostring(speedThreshold, "#.#") + "\n"
    string zoneLStr = na(zoneL) ? "n/a" : str.tostring(prevSwingLowValue - zoneL, format.mintick) + "–" + str.tostring(prevSwingLowValue + zoneL, format.mintick)
    tipL := tipL + (f5L ? "🟢" : "⚪") + " Retests    15%  " + str.tostring(retL) + " touches [zone " + zoneLStr + " ±" + str.tostring(retestAtrMult, "#.##") + "·ATR] vs " + str.tostring(retestMin) + "\n"
    tipL := tipL + (f6L ? "🟢" : "⚪") + " Confluence 20%  " + (confStrL != "" ? confStrL : "none") + "\n"
    tipL := tipL + (f7L ? "🟢" : "⚪") + " RSI Div    +5%  " + (f7L ? "yes (bullish — confirms exhaustion)" : "no") + "\n"
    tipL := tipL + (f8L ? "🟢" : "⚪") + " Structure   5%  " + (f8L ? "BOS (LL)" : "none") + "\n"
    tipL := tipL + "─────────────────\n"
    tipL := tipL + "Max possible: 100% (all 8 factors, incl. RSI Div)\n"
    tipL := tipL + "Threshold: " + (useZScore ? "Z-score" : "Fixed") + " · LB=" + str.tostring(zLookback) + " bars (" + (autoZLB ? "auto, " : "manual, ") + tfStr + ")"
    frozenLowTip := showTooltip ? tipL : ""

    if not na(badgeLowL)
        label.delete(badgeLowL)
    if not na(badgeLowR)
        label.delete(badgeLowR)
    string volTxtL = "V-" + frozenLowVolStr
    string scrTxtL = str.tostring(cntL) + "/" + str.tostring(scrL, "#.#") + "%"
    // v4.1.3: Low badges via badgeBaseATR (unchanged visual: -3.5 / -1.6)
    badgeLowL := label.new(pivotBarL, sLow - atr * badgeBaseATR * 3.5, volTxtL, style=label.style_label_center, textcolor=color.white, size=size.small, textalign=text.align_center, color=color.new(color.black, 70))
    badgeLowR := label.new(pivotBarL, sLow - atr * badgeBaseATR * 1.6, scrTxtL, style=label.style_label_center, textcolor=color.white, size=size.small, textalign=text.align_center, color=color.new(color.black, 70))

    prevSwingLowValue   := sLow
    prevSwingLowBar     := pivotBarL
    prevSwingLowConfBar := bar_index
    prevSwingLowAtr     := atrL

// ============== TRIANGLE LABELS ==============
if newHigh
    int    szIdxH = showStrength ? nz(frozenHighSize, 1) : 1
    string szH    = szIdxH == 1 ? size.tiny : szIdxH == 2 ? size.small : size.normal
    color  colH   = showStrength ? color.new(colHighMain, 40) : colHighMain
    string tH     = showStrength and showTooltip ? frozenHighTip : ""
    label  triH   = label.new(math.max(bar_index - highStrength, 0), sHigh, "", style=label.style_triangledown, color=colH, size=szH, tooltip=tH)
    array.push(hTriLabels, triH)
    while array.size(hTriLabels) > MAX_TRI_LABELS
        label.delete(array.shift(hTriLabels))

if newLow
    int    szIdxL = showStrength ? nz(frozenLowSize, 1) : 1
    string szL    = szIdxL == 1 ? size.tiny : szIdxL == 2 ? size.small : size.normal
    color  colL   = showStrength ? color.new(colLowMain, 40) : colLowMain
    string tL     = showStrength and showTooltip ? frozenLowTip : ""
    label  triL   = label.new(math.max(bar_index - lowStrength, 0), sLow, "", style=label.style_triangleup, color=colL, size=szL, tooltip=tL)
    array.push(lTriLabels, triL)
    while array.size(lTriLabels) > MAX_TRI_LABELS
        label.delete(array.shift(lTriLabels))

// ============== CURRENT TF: LINES ==============
var line activeHighLine = na
var line activeLowLine  = na

if newHigh
    if not na(activeHighLine)
        line.delete(activeHighLine)
    activeHighLine := line.new(activeHighStart, sHigh, bar_index, sHigh, color=colHighMain, width=solidWidth, style=line.style_solid)
if newLow
    if not na(activeLowLine)
        line.delete(activeLowLine)
    activeLowLine := line.new(activeLowStart, sLow, bar_index, sLow, color=colLowMain, width=solidWidth, style=line.style_solid)
if not na(activeHighLine)
    line.set_x2(activeHighLine, bar_index)
if not na(activeLowLine)
    line.set_x2(activeLowLine, bar_index)

// ============== CURRENT TF: DOTS ==============
plot(activeHighValue, title="SH active", style=plot.style_circles, color=colHighMain, linewidth=circleWidth, display=display.all)
plot(activeLowValue,  title="SL active", style=plot.style_circles, color=colLowMain,  linewidth=circleWidth, display=display.all)

dispPane = display.pane

hFill1  = highStrength >= 1  ? activeHighValue : na
hFill2  = highStrength >= 2  ? activeHighValue : na
hFill3  = highStrength >= 3  ? activeHighValue : na
hFill4  = highStrength >= 4  ? activeHighValue : na
hFill5  = highStrength >= 5  ? activeHighValue : na
hFill6  = highStrength >= 6  ? activeHighValue : na
hFill7  = highStrength >= 7  ? activeHighValue : na
hFill8  = highStrength >= 8  ? activeHighValue : na
hFill9  = highStrength >= 9  ? activeHighValue : na
hFill10 = highStrength >= 10 ? activeHighValue : na

plot(hFill1,  title="SH fill 1",  style=plot.style_circles, color=colHighMain, linewidth=circleWidth, offset=-1,  display=dispPane)
plot(hFill2,  title="SH fill 2",  style=plot.style_circles, color=colHighMain, linewidth=circleWidth, offset=-2,  display=dispPane)
plot(hFill3,  title="SH fill 3",  style=plot.style_circles, color=colHighMain, linewidth=circleWidth, offset=-3,  display=dispPane)
plot(hFill4,  title="SH fill 4",  style=plot.style_circles, color=colHighMain, linewidth=circleWidth, offset=-4,  display=dispPane)
plot(hFill5,  title="SH fill 5",  style=plot.style_circles, color=colHighMain, linewidth=circleWidth, offset=-5,  display=dispPane)
plot(hFill6,  title="SH fill 6",  style=plot.style_circles, color=colHighMain, linewidth=circleWidth, offset=-6,  display=dispPane)
plot(hFill7,  title="SH fill 7",  style=plot.style_circles, color=colHighMain, linewidth=circleWidth, offset=-7,  display=dispPane)
plot(hFill8,  title="SH fill 8",  style=plot.style_circles, color=colHighMain, linewidth=circleWidth, offset=-8,  display=dispPane)
plot(hFill9,  title="SH fill 9",  style=plot.style_circles, color=colHighMain, linewidth=circleWidth, offset=-9,  display=dispPane)
plot(hFill10, title="SH fill 10", style=plot.style_circles, color=colHighMain, linewidth=circleWidth, offset=-10, display=dispPane)

lFill1  = lowStrength >= 1  ? activeLowValue : na
lFill2  = lowStrength >= 2  ? activeLowValue : na
lFill3  = lowStrength >= 3  ? activeLowValue : na
lFill4  = lowStrength >= 4  ? activeLowValue : na
lFill5  = lowStrength >= 5  ? activeLowValue : na
lFill6  = lowStrength >= 6  ? activeLowValue : na
lFill7  = lowStrength >= 7  ? activeLowValue : na
lFill8  = lowStrength >= 8  ? activeLowValue : na
lFill9  = lowStrength >= 9  ? activeLowValue : na
lFill10 = lowStrength >= 10 ? activeLowValue : na

plot(lFill1,  title="SL fill 1",  style=plot.style_circles, color=colLowMain, linewidth=circleWidth, offset=-1,  display=dispPane)
plot(lFill2,  title="SL fill 2",  style=plot.style_circles, color=colLowMain, linewidth=circleWidth, offset=-2,  display=dispPane)
plot(lFill3,  title="SL fill 3",  style=plot.style_circles, color=colLowMain, linewidth=circleWidth, offset=-3,  display=dispPane)
plot(lFill4,  title="SL fill 4",  style=plot.style_circles, color=colLowMain, linewidth=circleWidth, offset=-4,  display=dispPane)
plot(lFill5,  title="SL fill 5",  style=plot.style_circles, color=colLowMain, linewidth=circleWidth, offset=-5,  display=dispPane)
plot(lFill6,  title="SL fill 6",  style=plot.style_circles, color=colLowMain, linewidth=circleWidth, offset=-6,  display=dispPane)
plot(lFill7,  title="SL fill 7",  style=plot.style_circles, color=colLowMain, linewidth=circleWidth, offset=-7,  display=dispPane)
plot(lFill8,  title="SL fill 8",  style=plot.style_circles, color=colLowMain, linewidth=circleWidth, offset=-8,  display=dispPane)
plot(lFill9,  title="SL fill 9",  style=plot.style_circles, color=colLowMain, linewidth=circleWidth, offset=-9,  display=dispPane)
plot(lFill10, title="SL fill 10", style=plot.style_circles, color=colLowMain, linewidth=circleWidth, offset=-10, display=dispPane)

// ============== HTF LINES ==============
var line l1hHigh = na
var line l1hLow  = na
var line l4hHigh = na
var line l4hLow  = na
var line lDHigh  = na
var line lDLow   = na
var line lWHigh  = na
var line lWLow   = na

if show1h and not na(v1hHigh) and not na(t1hHigh)
    if na(l1hHigh)
        l1hHigh := line.new(t1hHigh, v1hHigh, time, v1hHigh, xloc=xloc.bar_time, color=col1HHigh, width=2, style=line.style_solid)
    else
        line.set_x1(l1hHigh, t1hHigh)
        line.set_y1(l1hHigh, v1hHigh)
        line.set_x2(l1hHigh, time)
        line.set_y2(l1hHigh, v1hHigh)
if show1h and not na(v1hLow) and not na(t1hLow)
    if na(l1hLow)
        l1hLow := line.new(t1hLow, v1hLow, time, v1hLow, xloc=xloc.bar_time, color=col1HLow, width=2, style=line.style_solid)
    else
        line.set_x1(l1hLow, t1hLow)
        line.set_y1(l1hLow, v1hLow)
        line.set_x2(l1hLow, time)
        line.set_y2(l1hLow, v1hLow)
if show4h and not na(v4hHigh) and not na(t4hHigh)
    if na(l4hHigh)
        l4hHigh := line.new(t4hHigh, v4hHigh, time, v4hHigh, xloc=xloc.bar_time, color=col4HHigh, width=3, style=line.style_solid)
    else
        line.set_x1(l4hHigh, t4hHigh)
        line.set_y1(l4hHigh, v4hHigh)
        line.set_x2(l4hHigh, time)
        line.set_y2(l4hHigh, v4hHigh)
if show4h and not na(v4hLow) and not na(t4hLow)
    if na(l4hLow)
        l4hLow := line.new(t4hLow, v4hLow, time, v4hLow, xloc=xloc.bar_time, color=col4HLow, width=3, style=line.style_solid)
    else
        line.set_x1(l4hLow, t4hLow)
        line.set_y1(l4hLow, v4hLow)
        line.set_x2(l4hLow, time)
        line.set_y2(l4hLow, v4hLow)
if showD and not na(vDHigh) and not na(tDHigh)
    if na(lDHigh)
        lDHigh := line.new(tDHigh, vDHigh, time, vDHigh, xloc=xloc.bar_time, color=colDHigh, width=3, style=line.style_solid)
    else
        line.set_x1(lDHigh, tDHigh)
        line.set_y1(lDHigh, vDHigh)
        line.set_x2(lDHigh, time)
        line.set_y2(lDHigh, vDHigh)
if showD and not na(vDLow) and not na(tDLow)
    if na(lDLow)
        lDLow := line.new(tDLow, vDLow, time, vDLow, xloc=xloc.bar_time, color=colDLow, width=3, style=line.style_solid)
    else
        line.set_x1(lDLow, tDLow)
        line.set_y1(lDLow, vDLow)
        line.set_x2(lDLow, time)
        line.set_y2(lDLow, vDLow)
if showW and not na(vWHigh) and not na(tWHigh)
    if na(lWHigh)
        lWHigh := line.new(tWHigh, vWHigh, time, vWHigh, xloc=xloc.bar_time, color=colWHigh, width=4, style=line.style_solid)
    else
        line.set_x1(lWHigh, tWHigh)
        line.set_y1(lWHigh, vWHigh)
        line.set_x2(lWHigh, time)
        line.set_y2(lWHigh, vWHigh)
if showW and not na(vWLow) and not na(tWLow)
    if na(lWLow)
        lWLow := line.new(tWLow, vWLow, time, vWLow, xloc=xloc.bar_time, color=colWLow, width=4, style=line.style_solid)
    else
        line.set_x1(lWLow, tWLow)
        line.set_y1(lWLow, vWLow)
        line.set_x2(lWLow, time)
        line.set_y2(lWLow, vWLow)

// ============== HTF MARKERS ==============
plot(show1h and barstate.islast ? v1hHigh : na, title="1H H mk", style=plot.style_circles, color=col1HHigh, linewidth=2, display=display.pane)
plot(show1h and barstate.islast ? v1hLow  : na, title="1H L mk", style=plot.style_circles, color=col1HLow,  linewidth=2, display=display.pane)
plot(show4h and barstate.islast ? v4hHigh : na, title="4H H mk", style=plot.style_circles, color=col4HHigh, linewidth=2, display=display.pane)
plot(show4h and barstate.islast ? v4hLow  : na, title="4H L mk", style=plot.style_circles, color=col4HLow,  linewidth=2, display=display.pane)
plot(showD and barstate.islast ? vDHigh : na, title="D H mk", style=plot.style_circles, color=colDHigh, linewidth=2, display=display.pane)
plot(showD and barstate.islast ? vDLow  : na, title="D L mk", style=plot.style_circles, color=colDLow,  linewidth=2, display=display.pane)
plot(showW and barstate.islast ? vWHigh : na, title="W H mk", style=plot.style_circles, color=colWHigh, linewidth=2, display=display.pane)
plot(showW and barstate.islast ? vWLow  : na, title="W L mk", style=plot.style_circles, color=colWLow,  linewidth=2, display=display.pane)

// ============== HTF COMBINED LABELS ==============
var label hG1 = na
var label hG2 = na
var label hG3 = na
var label hG4 = na
var label lG1 = na
var label lG2 = na
var label lG3 = na
var label lG4 = na

if barstate.islast
    bool wEx  = showW  and not na(vWHigh)
    bool dEx  = showD  and not na(vDHigh)
    bool h4Ex = show4h and not na(v4hHigh)
    bool h1Ex = show1h and not na(v1hHigh)
    bool dW   = wEx and dEx and math.abs(vDHigh - vWHigh) / vWHigh <= 0.001
    bool h4W  = wEx and h4Ex and math.abs(v4hHigh - vWHigh) / vWHigh <= 0.001
    bool h4D  = dEx and not dW and h4Ex and math.abs(v4hHigh - vDHigh) / vDHigh <= 0.001
    bool h1W  = wEx and h1Ex and math.abs(v1hHigh - vWHigh) / vWHigh <= 0.001
    bool h1D  = dEx and not dW and h1Ex and not h1W and math.abs(v1hHigh - vDHigh) / vDHigh <= 0.001
    bool h1H4 = h4Ex and not h4W and not h4D and h1Ex and not h1W and not h1D and math.abs(v1hHigh - v4hHigh) / v4hHigh <= 0.001

    if wEx
        string txt = "▼ W" + (dW?"/▼ D":"") + (h4W?"/▼ 4H":"") + (h1W?"/▼ 1H":"") + ": " + str.tostring(vWHigh, format.mintick)
        float y = vWHigh + 0.2 * atr
        if na(hG1)
            hG1 := label.new(bar_index, y, txt, style=label.style_none, textcolor=colWHigh, size=size.normal, textalign=text.align_left)
        else
            label.set_xy(hG1, bar_index, y)
            label.set_text(hG1, txt)
    else
        if not na(hG1)
            label.delete(hG1)
            hG1 := na

    if dEx and not dW
        string txt = "▼ D" + (h4D?"/▼ 4H":"") + (h1D?"/▼ 1H":"") + ": " + str.tostring(vDHigh, format.mintick)
        float y = vDHigh + 0.35 * atr
        if na(hG2)
            hG2 := label.new(bar_index, y, txt, style=label.style_none, textcolor=colDHigh, size=size.normal, textalign=text.align_left)
        else
            label.set_xy(hG2, bar_index, y)
            label.set_text(hG2, txt)
    else
        if not na(hG2)
            label.delete(hG2)
            hG2 := na

    if h4Ex and not h4W and not h4D
        string txt = "▼ 4H" + (h1H4?"/▼ 1H":"") + ": " + str.tostring(v4hHigh, format.mintick)
        float y = v4hHigh + 0.5 * atr
        if na(hG3)
            hG3 := label.new(bar_index, y, txt, style=label.style_none, textcolor=col4HHigh, size=size.normal, textalign=text.align_left)
        else
            label.set_xy(hG3, bar_index, y)
            label.set_text(hG3, txt)
    else
        if not na(hG3)
            label.delete(hG3)
            hG3 := na

    if h1Ex and not h1W and not h1D and not h1H4
        string txt = "▼ 1H: " + str.tostring(v1hHigh, format.mintick)
        float y = v1hHigh + 0.65 * atr
        if na(hG4)
            hG4 := label.new(bar_index, y, txt, style=label.style_none, textcolor=col1HHigh, size=size.normal, textalign=text.align_left)
        else
            label.set_xy(hG4, bar_index, y)
            label.set_text(hG4, txt)
    else
        if not na(hG4)
            label.delete(hG4)
            hG4 := na

    bool wLEx  = showW  and not na(vWLow)
    bool dLEx  = showD  and not na(vDLow)
    bool h4LEx = show4h and not na(v4hLow)
    bool h1LEx = show1h and not na(v1hLow)
    bool dLW   = wLEx and dLEx and math.abs(vDLow - vWLow) / vWLow <= 0.001
    bool h4LW  = wLEx and h4LEx and math.abs(v4hLow - vWLow) / vWLow <= 0.001
    bool h4LD  = dLEx and not dLW and h4LEx and math.abs(v4hLow - vDLow) / vDLow <= 0.001
    bool h1LW  = wLEx and h1LEx and math.abs(v1hLow - vWLow) / vWLow <= 0.001
    bool h1LD  = dLEx and not dLW and h1LEx and not h1LW and math.abs(v1hLow - vDLow) / vDLow <= 0.001
    bool h1LH4 = h4LEx and not h4LW and not h4LD and h1LEx and not h1LW and not h1LD and math.abs(v1hLow - v4hLow) / v4hLow <= 0.001

    if wLEx
        string txt = "▲ W" + (dLW?"/▲ D":"") + (h4LW?"/▲ 4H":"") + (h1LW?"/▲ 1H":"") + ": " + str.tostring(vWLow, format.mintick)
        float y = vWLow - 0.2 * atr
        if na(lG1)
            lG1 := label.new(bar_index, y, txt, style=label.style_none, textcolor=colWLow, size=size.normal, textalign=text.align_left)
        else
            label.set_xy(lG1, bar_index, y)
            label.set_text(lG1, txt)
    else
        if not na(lG1)
            label.delete(lG1)
            lG1 := na

    if dLEx and not dLW
        string txt = "▲ D" + (h4LD?"/▲ 4H":"") + (h1LD?"/▲ 1H":"") + ": " + str.tostring(vDLow, format.mintick)
        float y = vDLow - 0.35 * atr
        if na(lG2)
            lG2 := label.new(bar_index, y, txt, style=label.style_none, textcolor=colDLow, size=size.normal, textalign=text.align_left)
        else
            label.set_xy(lG2, bar_index, y)
            label.set_text(lG2, txt)
    else
        if not na(lG2)
            label.delete(lG2)
            lG2 := na

    if h4LEx and not h4LW and not h4LD
        string txt = "▲ 4H" + (h1LH4?"/▲ 1H":"") + ": " + str.tostring(v4hLow, format.mintick)
        float y = v4hLow - 0.5 * atr
        if na(lG3)
            lG3 := label.new(bar_index, y, txt, style=label.style_none, textcolor=col4HLow, size=size.normal, textalign=text.align_left)
        else
            label.set_xy(lG3, bar_index, y)
            label.set_text(lG3, txt)
    else
        if not na(lG3)
            label.delete(lG3)
            lG3 := na

    if h1LEx and not h1LW and not h1LD and not h1LH4
        string txt = "▲ 1H: " + str.tostring(v1hLow, format.mintick)
        float y = v1hLow - 0.65 * atr
        if na(lG4)
            lG4 := label.new(bar_index, y, txt, style=label.style_none, textcolor=col1HLow, size=size.normal, textalign=text.align_left)
        else
            label.set_xy(lG4, bar_index, y)
            label.set_text(lG4, txt)
    else
        if not na(lG4)
            label.delete(lG4)
            lG4 := na

// ============== DASHBOARD ==============
dashPos = dashPosStr == "Top Right" ? position.top_right : dashPosStr == "Top Left" ? position.top_left : dashPosStr == "Bottom Right" ? position.bottom_right : position.bottom_left
var table dash = table.new(dashPos, 3, 15, border_width=1, border_color=color.new(color.gray, 70))

if showDashboard and barstate.islast
    table.cell(dash, 0, 0, "Metric", bgcolor=color.new(color.gray, 80), text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 0, "▼ High", bgcolor=color.new(colHighMain, 80), text_color=colHighMain, text_size=size.small)
    table.cell(dash, 2, 0, "▲ Low",  bgcolor=color.new(colLowMain,  80), text_color=colLowMain,  text_size=size.small)

    string priceH = na(activeHighValue) ? "—" : str.tostring(activeHighValue, format.mintick)
    string priceL = na(activeLowValue)  ? "—" : str.tostring(activeLowValue,  format.mintick)
    string scrHs  = na(frozenHighScore) ? "—" : str.tostring(frozenHighScore, "#.#") + "%"
    string scrLs  = na(frozenLowScore)  ? "—" : str.tostring(frozenLowScore,  "#.#") + "%"
    string volH   = frozenHighVolStr == "" ? "—" : frozenHighVolStr
    string volL   = frozenLowVolStr  == "" ? "—" : frozenLowVolStr
    string qH     = na(frozenHighScore) ? "—" : qualityLabel(frozenHighScore)
    string qL     = na(frozenLowScore)  ? "—" : qualityLabel(frozenLowScore)
    string cntH   = na(frozenHighCnt)   ? "—" : str.tostring(frozenHighCnt) + "/8"
    string cntL   = na(frozenLowCnt)    ? "—" : str.tostring(frozenLowCnt)  + "/8"

    table.cell(dash, 0, 1, "Price",   text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 1, priceH,    text_color=colHighMain, text_size=size.small)
    table.cell(dash, 2, 1, priceL,    text_color=colLowMain,  text_size=size.small)
    table.cell(dash, 0, 2, "Score",   text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 2, scrHs,     text_color=color.white, text_size=size.small)
    table.cell(dash, 2, 2, scrLs,     text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 3, "Vol, rub", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 3, volH,      text_color=color.white, text_size=size.small)
    table.cell(dash, 2, 3, volL,      text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 4, "Quality", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 4, qH,        text_color=color.white, text_size=size.small)
    table.cell(dash, 2, 4, qL,        text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 5, "Factors", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 5, cntH,      text_color=color.white, text_size=size.small)
    table.cell(dash, 2, 5, cntL,      text_color=color.white, text_size=size.small)

    if not compactDash
        string[] fnames = array.from("Volume", "Range", "Wick", "Speed", "Retests", "Confluence", "RSI Div", "Structure")
        for i = 0 to 7
            bool fHv = array.size(hF) > i ? array.get(hF, i) : false
            bool fLv = array.size(lF) > i ? array.get(lF, i) : false
            table.cell(dash, 0, 6 + i, array.get(fnames, i), text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
            table.cell(dash, 1, 6 + i, fHv ? "✅" : "⬜", text_color=color.white, text_size=size.tiny)
            table.cell(dash, 2, 6 + i, fLv ? "✅" : "⬜", text_color=color.white, text_size=size.tiny)

        if useSynth
            string synthStatus = str.tostring(validSynth) + "/25"
            table.cell(dash, 0, 14, "Synth", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
            table.cell(dash, 1, 14, synthStatus, text_color=(validSynth == 25 ? color.lime : color.orange), text_size=size.tiny)
            table.cell(dash, 2, 14, "", text_color=color.white, text_size=size.tiny)

// ============== INFO TABLE ==============
var int lastSHbar = na
var int lastSLbar = na
var float sumSHdist = 0.0
var int cntSH = 0
var float sumSLdist = 0.0
var int cntSL = 0

if not na(sHigh)
    int aSH = bar_index - highStrength
    if not na(lastSHbar)
        sumSHdist += aSH - lastSHbar
        cntSH     += 1
    lastSHbar := aSH
if not na(sLow)
    int aSL = bar_index - lowStrength
    if not na(lastSLbar)
        sumSLdist += aSL - lastSLbar
        cntSL     += 1
    lastSLbar := aSL

avgSH = cntSH > 0 ? sumSHdist / cntSH : na
avgSL = cntSL > 0 ? sumSLdist / cntSL : na

var table info = table.new(position.top_left, 2, 3, border_width=1)

if showInfoTable and barstate.islast
    table.cell(info, 0, 0, "Metric", bgcolor=color.new(color.gray, 80))
    table.cell(info, 1, 0, "Value",  bgcolor=color.new(color.gray, 80))
    table.cell(info, 0, 1, "Avg bars between Swing High")
    table.cell(info, 1, 1, na(avgSH) ? "n/a" : str.tostring(avgSH, "#.##"))
    table.cell(info, 0, 2, "Avg bars between Swing Low")
    table.cell(info, 1, 2, na(avgSL) ? "n/a" : str.tostring(avgSL, "#.##"))