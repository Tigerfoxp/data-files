[v_sh_32, c_sh_32] = request.security(exchPrefix + t32, timeframe.period, [volume, close], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[v_sh_33, c_sh_33] = request.security(exchPrefix + t33, timeframe.period, [volume, close], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[v_sh_34, c_sh_34] = request.security(exchPrefix + t34, timeframe.period, [volume, close], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[v_sh_35, c_sh_35] = request.security(exchPrefix + t35, timeframe.period, [volume, close], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[v_sh_36, c_sh_36] = request.security(exchPrefix + t36, timeframe.period, [volume, close], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

sv1  = nz(v_sh_01) * nz(c_sh_01)
sv2  = nz(v_sh_02) * nz(c_sh_02)
sv3  = nz(v_sh_03) * nz(c_sh_03)
sv4  = nz(v_sh_04) * nz(c_sh_04)
sv5  = nz(v_sh_05) * nz(c_sh_05)
sv6  = nz(v_sh_06) * nz(c_sh_06)
sv7  = nz(v_sh_07) * nz(c_sh_07)
sv8  = nz(v_sh_08) * nz(c_sh_08)
sv9  = nz(v_sh_09) * nz(c_sh_09)
sv10 = nz(v_sh_10) * nz(c_sh_10)
sv11 = nz(v_sh_11) * nz(c_sh_11)
sv12 = nz(v_sh_12) * nz(c_sh_12)
sv13 = nz(v_sh_13) * nz(c_sh_13)
